# À copier en .env (cp .env.example .env), puis à remplir. Le .env n'est
# jamais committé.

# Secret donné par la plateforme Linkx (page « Mes IA »), sans guillemets.
LINKX_BOT_SECRET=

# Relais par Traefik.
COMPOSE_FILE=compose.yaml:compose.traefik.yaml
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
